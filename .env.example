# HeritageRisk AI — environment variable template
#
# Copy this file to .env and fill in only the values needed locally. Public
# submission and offline mock analysis work without Azure credentials, while
# reviewer actions stay locked until the reviewer settings below are configured.
#
# NEVER commit your real .env file. It is already listed in .gitignore.

# Reviewer access
# Keep these blank until reviewer login is configured. Generate the password
# hash without putting the password in shell history:
#   cd backend
#   python3 -c 'from app.auth import hash_reviewer_password; import getpass; print(hash_reviewer_password(getpass.getpass()))'
# Generate a stable signing secret with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
REVIEWER_USERNAME=
REVIEWER_PASSWORD_HASH=
SESSION_SECRET_KEY=

# "false" (default) → rule-based mock analysis, no API call, no credentials needed.
# "true"            → real Azure OpenAI call (requires credentials below).
AZURE_OPENAI_ENABLED=false

# Required only when AZURE_OPENAI_ENABLED=true.
# Find these in Azure Portal → your Azure OpenAI resource → Keys and Endpoint.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
# This is the Azure deployment name, which may differ from the model name.
AZURE_OPENAI_DEPLOYMENT=YOUR_GPT5_MINI_DEPLOYMENT_NAME
# The app uses Azure's /openai/v1/ endpoint, which does not take a dated query parameter.
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_TIMEOUT_SECONDS=30
