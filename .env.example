# HeritageRisk AI — environment variable template
#
# Copy this file to .env and fill in real values ONLY when you are ready
# to connect to Azure OpenAI. The app runs fine with all values left blank
# or with AI_ANALYSIS_ENABLED=false.
#
# NEVER commit your real .env file. It is already listed in .gitignore.

# ── Feature flag ──────────────────────────────────────────────────────────────
# "false" (default) → rule-based mock analysis, no API call, no credentials needed.
# "true"            → real Azure OpenAI Vision call (requires credentials below).
AI_ANALYSIS_ENABLED=false

# ── Azure OpenAI credentials ──────────────────────────────────────────────────
# Required only when AI_ANALYSIS_ENABLED=true.
# Find these in Azure Portal → your Azure OpenAI resource → Keys and Endpoint.
#
# AZURE_OPENAI_DEPLOYMENT must be a vision-capable model deployment,
# e.g. gpt-4o, gpt-4-turbo (with vision), or gpt-4-vision-preview.
# Standard text-only deployments will fail.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-vision-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-01
